{
  "expo": {
    "name": "Receipt Scanner",
    "slug": "receiptscannerapp",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "receiptscannerapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.receiptscannerapp.app",
      "buildNumber": "15",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true,
        "NSCameraUsageDescription": "小票を撮影して認識するため、カメラを使用します。",
        "NSPhotoLibraryUsageDescription": "小票画像を選択して認識するため、写真ライブラリへのアクセスを使用します。"
      }
    },
    "android": {
      "package": "com.receiptscannerapp.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "小票画像を選択して認識するため、写真ライブラリへのアクセスを使用します。",
          "cameraPermission": "小票を撮影して認識するため、カメラを使用します。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "locales": {
      "ja": "./locales/native/ja.json",
      "zh-Hans": "./locales/native/zh-Hans.json",
      "en": "./locales/native/en.json"
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "566985cc-f306-4382-b2f7-ff87841696c1"
      }
    }
  }
}
