# ReceiptScannerApp — 环境变量示例
# 复制为 .env 后填入真实值，不要提交 .env 到版本库

# ---------- Supabase（必填：OCR / 分类 / 反馈均依赖）----------
# 项目 URL，如 https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Legacy anon key（eyJ 开头的 JWT），在 Supabase Dashboard → API 中复制
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ---------- 可选：本地开发时覆盖（与上面二选一或同时存在，extra 会注入到 app）----------
# SUPABASE_URL=
# SUPABASE_ANON_KEY=

# ---------- 隐私政策（可选）----------
# 不填则使用默认 Edge Function URL
# EXPO_PUBLIC_PRIVACY_POLICY_URL=

# ---------- 开发调试：直连 Gemini（仅 __DEV__ 生效）----------
# 设为 true 时跳过 Edge OCR，直连 Gemini；需同时配置 GEMINI_API_KEY
# DEV_DIRECT_GEMINI=false
# GEMINI_API_KEY=

# ---------- 云端 OCR（ocr-receipt-v2）----------
# 云端 OCR 需要有效的 Supabase 用户 access token。
# ENABLE_ANON_AUTH=true 时，没有现成会话就会按需匿名登录。
# 应用里已经有其他有效 Supabase 用户会话时，不必依赖这次匿名登录。
# 代码默认仍是关闭。EAS 的 development、preview、validation、production 会显式设为 true。
# 日常开发/预览指向 .env 里的远程 Supabase 项目，该项目必须允许匿名登录。
# 本地 `supabase start` 不是默认的云端 OCR 路径；supabase/config.toml 保持
# enable_anonymous_sign_ins = false。只有故意把云端 OCR 打到本地 Supabase 时，
# 才在本地配置里打开匿名登录。
# ENABLE_ANON_AUTH=true

# ---------- 备用反馈邮箱（可选）----------
# 设置后，在在线反馈不可用时可提供邮件兜底渠道，例如 support@example.com
# EXPO_PUBLIC_SUPPORT_EMAIL=
