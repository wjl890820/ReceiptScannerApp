{
  "cli": {
    "version": ">= 16.28.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "ENABLE_ANALYSIS_PRICE_CHANGES": "false"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "ENABLE_ANALYSIS_PRICE_CHANGES": "false"
      }
    },
    "validation": {
      "distribution": "store",
      "autoIncrement": true,
      "env": {
        "ENABLE_ANON_AUTH": "true",
        "ENABLE_CLOUD_BACKUP": "true",
        "ENABLE_APPLE_LINK": "true",
        "ENABLE_ANALYSIS_D_DIAGNOSTICS": "true",
        "ENABLE_INTERNAL_DIAGNOSTICS": "true",
        "ENABLE_ANALYSIS_PRICE_CHANGES": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "ENABLE_ANON_AUTH": "true",
        "ENABLE_CLOUD_BACKUP": "true",
        "ENABLE_APPLE_LINK": "true",
        "ENABLE_ANALYSIS_PRICE_CHANGES": "false"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "ascAppId": "6758438546"
      }
    }
  }
}
